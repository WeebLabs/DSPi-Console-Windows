<Window
    x:Class="DSPiConsole.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DSPiConsole"
    xmlns:controls="using:DSPiConsole.Controls"
    xmlns:converters="using:DSPiConsole.Converters"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:DSPiConsole.Core.Models"
    Title="DSPi Console">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="TitleBarMenuButton" Grid.Column="0" VerticalAlignment="Center"
                    Padding="6" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE700;" FontSize="14"/>
                <Button.Flyout>
                    <MenuFlyout x:Name="MainMenu" Placement="BottomEdgeAlignedLeft" Opening="OnMainMenuOpening">
                        <MenuFlyoutSubItem Text="Import">
                            <MenuFlyoutItem x:Name="ImportPresetMenuItem" Text="Preset File..." Click="OnImportPresetClick"/>
                            <MenuFlyoutItem Text="Filters..." Click="OnImportFiltersClick">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="I"/>
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem Text="Export">
                            <MenuFlyoutItem x:Name="ExportPresetMenuItem" Text="Preset File..." Click="OnExportPresetClick"/>
                            <MenuFlyoutItem Text="Filters..." Click="OnExportFiltersClick">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="E"/>
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutSubItem x:Name="AutoEQMenu" Text="AutoEQ">
                            <MenuFlyoutItem Text="Browse Profiles..." Click="OnAutoEQBrowseClick">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control,Shift" Key="B"/>
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Update Database..." Click="OnAutoEQUpdateClick"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutSubItem x:Name="AutoEQFavoritesMenu" Text="Favorites"/>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Loudness Compensation..." Click="OnLoudnessClick">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="L"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Crossfeed..." Click="OnCrossfeedClick">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="X"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Psychoacoustic Bass..." Click="OnPsybassClick">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="P"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Subharmonic Synthesizer..." Click="OnSubharmClick">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="S"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Tube Modeller..." Click="OnTubeClick">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="D"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Stereo Upmixer..." Click="OnUpmixClick">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="U"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Volume Leveller..." Click="OnLevellerClick">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="V"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Matrix Mixer..." Click="OnMatrixMixerClick">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="M"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Spectrum Analyser..." Click="OnSpectrumAnalyserClick">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="A"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Test Signal Generator..." Click="OnTestSignalsClick">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="G"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Stats for nerbs" Click="OnStatsClick">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="T"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Interrupt Monitor..." Click="OnInterruptMonitorClick">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="I"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="SettingsMenuItem" Text="Settings..." Click="OnSettingsClick"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Save Preset" Click="OnSavePresetClick">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="S"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="SaveMasterVolumeMenuItem" Text="Save Master Volume"
                                        Click="OnSaveMasterVolumeClick"/>
                        <MenuFlyoutItem x:Name="SaveOutputConfigMenuItem" Text="Save Output Config"
                                        Click="OnSaveOutputConfigClick"/>
                        <MenuFlyoutItem Text="Revert Preset..." Click="OnRevertPresetClick"/>
                        <MenuFlyoutItem Text="Factory Reset..." Click="OnFactoryResetClick"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Update Firmware..." Click="OnUpdateFirmwareClick"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutSubItem x:Name="HelpMenu" Text="Help">
                            <MenuFlyoutItem Text="Getting Started..." Click="OnGettingStartedClick"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="What's New in DSPi Console" Click="OnWhatsNewClick"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="DSPi Console on GitHub" Click="OnConsoleGitHubClick"/>
                            <MenuFlyoutItem Text="DSPi Firmware on GitHub" Click="OnFirmwareGitHubClick"/>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem x:Name="ExitMenuItem" Text="Exit" Click="OnExitClick">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Menu" Key="F4"/>
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <TextBlock x:Name="AppTitleText" Grid.Column="1" Text="DSPi Console"
                       VerticalAlignment="Center"
                       Margin="4,0,0,0"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>

        <Grid x:Name="RootGrid" Grid.Row="1">
            <Grid.Resources>
                <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
                <converters:ChannelToBrushConverter x:Key="ChannelToBrush" />
                <converters:FloatFormatConverter x:Key="FloatFormat" />

                <!-- Inline channel name textbox style - for in-place renaming -->
                <Style x:Key="ChannelNameTextBoxStyle" TargetType="TextBox">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="ContentElement"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Padding="{TemplateBinding Padding}"
                                              Margin="0"
                                              VerticalAlignment="Center"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"
                                              IsTabStop="False" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>

                <!-- Inline value textbox style - no visual feedback -->
                <Style x:Key="InlineValueTextBoxStyle" TargetType="TextBox">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="ContentElement"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Padding="{TemplateBinding Padding}"
                                              Margin="0"
                                              VerticalAlignment="Center"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"
                                              IsTabStop="False" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="2,0,2,0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Height" Value="20" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="TextAlignment" Value="Right" />
                </Style>

                <!-- Chromeless button for the sidebar badge hit area: being a real
                     Button keeps clicks from selecting the ListView row, and the
                     bare template adds no hover/press visuals. -->
                <Style x:Key="BadgeHitButtonStyle" TargetType="Button">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>

            <!--This determines the sidebar width-->
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="280" MinWidth="200" MaxWidth="300" />
				<ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Hidden focus sink - no visual feedback -->
            <Border x:Name="FocusSink" IsTabStop="True" Background="Transparent"
                    Width="0" Height="0" Opacity="0" Grid.Column="0" Grid.ColumnSpan="2" />

            <Grid Grid.Column="0" x:Name="SidebarGrid" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- This is where we set the inpupt and output channel text padding and styles-->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="12">
                        <TextBlock x:Name="InputsHeader" Text="INPUTS" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorGhostlyBrush}" Margin="0,8,0,4" />
                        <ListView x:Name="InputChannelsList" SelectionMode="Single" Margin="-12,0,-12,0" Padding="0"
                                  IsMultiSelectCheckBoxEnabled="False">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="22,0,12,0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>

                        <TextBlock x:Name="OutputsHeader" Text="OUTPUTS" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorGhostlyBrush}" Margin="0,16,0,4" />
                        <ListView x:Name="OutputChannelsList" SelectionMode="Single" Margin="-12,0,-12,0" Padding="0">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection/>
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="22,0,12,0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Padding="12,12,12,0" Spacing="12">
                    <!-- Shortcut icons row -->
                    <Grid Margin="-12,0,-12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                        <Border x:Name="SidebarMatrixMixerBtn" Grid.Column="0" Background="Transparent" Padding="0,6"
                                Tapped="OnSidebarMatrixMixerTapped"
                                ToolTipService.ToolTip="Matrix Mixer"
                                PointerEntered="OnShortcutIconPointerEntered" PointerExited="OnShortcutIconPointerExited">
                            <FontIcon x:Name="MatrixMixerIcon" Glyph="&#xE71D;" FontSize="16"
                                      HorizontalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorGhostlyBrush}" IsHitTestVisible="False" />
                        </Border>
                        <Border x:Name="SidebarSettingsBtn" Grid.Column="1" Background="Transparent" Padding="0,6"
                                Tapped="OnSidebarSettingsTapped"
                                ToolTipService.ToolTip="Settings"
                                PointerEntered="OnShortcutIconPointerEntered" PointerExited="OnShortcutIconPointerExited">
                            <FontIcon x:Name="SettingsIcon" Glyph="&#xE713;" FontSize="16"
                                      HorizontalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorGhostlyBrush}" IsHitTestVisible="False" />
                        </Border>
                        <Border x:Name="SidebarLoudnessBtn" Grid.Column="2" Background="Transparent" Padding="0,6"
                                Tapped="OnSidebarLoudnessTapped"
                                RightTapped="OnSidebarLoudnessRightClick"
                                ToolTipService.ToolTip="Loudness Compensation (right-click for settings)"
                                PointerEntered="OnShortcutIconPointerEntered" PointerExited="OnShortcutIconPointerExited">
                            <FontIcon x:Name="LoudnessIcon" Glyph="&#xE708;" FontSize="16"
                                      HorizontalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorGhostlyBrush}" IsHitTestVisible="False" />
                        </Border>
                        <Border x:Name="SidebarCrossfeedBtn" Grid.Column="3" Background="Transparent" Padding="0,6"
                                Tapped="OnSidebarCrossfeedTapped"
                                RightTapped="OnSidebarCrossfeedRightClick"
                                ToolTipService.ToolTip="Crossfeed (right-click for settings)"
                                PointerEntered="OnShortcutIconPointerEntered" PointerExited="OnShortcutIconPointerExited">
                            <FontIcon x:Name="CrossfeedIcon" Glyph="&#xE8AB;" FontSize="16"
                                      HorizontalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorGhostlyBrush}" IsHitTestVisible="False" />
                        </Border>
                        <Border x:Name="SidebarPsybassBtn" Grid.Column="4" Background="Transparent" Padding="0,6"
                                Tapped="OnSidebarPsybassTapped"
                                RightTapped="OnSidebarPsybassRightClick"
                                ToolTipService.ToolTip="Psychoacoustic Bass (right-click for settings)"
                                PointerEntered="OnShortcutIconPointerEntered" PointerExited="OnShortcutIconPointerExited">
                            <!-- Bass clef; not in Segoe Fluent Icons, so pull it from Segoe UI Symbol.
                                 The glyph sits small within its em box, so it runs a couple of
                                 points larger than the Fluent icons to match them optically. -->
                            <FontIcon x:Name="PsybassIcon" Glyph="&#x1D122;" FontSize="18"
                                      FontFamily="Segoe UI Symbol"
                                      HorizontalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorGhostlyBrush}" IsHitTestVisible="False" />
                        </Border>
                        <Border x:Name="SidebarLevellerBtn" Grid.Column="5" Background="Transparent" Padding="0,6"
                                Tapped="OnSidebarLevellerTapped"
                                RightTapped="OnSidebarLevellerRightClick"
                                ToolTipService.ToolTip="Volume Leveller (right-click for settings)"
                                PointerEntered="OnShortcutIconPointerEntered" PointerExited="OnShortcutIconPointerExited">
                            <FontIcon x:Name="LevellerIcon" Glyph="&#xE994;" FontSize="16"
                                      HorizontalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorGhostlyBrush}" IsHitTestVisible="False" />
                        </Border>
                        <Border x:Name="SidebarStatsBtn" Grid.Column="6" Background="Transparent" Padding="0,6"
                                Tapped="OnSidebarStatsTapped"
                                ToolTipService.ToolTip="Stats for Nerbs"
                                PointerEntered="OnShortcutIconPointerEntered" PointerExited="OnShortcutIconPointerExited">
                            <FontIcon x:Name="StatsIcon" Glyph="&#xE9D9;" FontSize="16"
                                      HorizontalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorGhostlyBrush}" IsHitTestVisible="False" />
                        </Border>
                        <Border x:Name="SidebarBypassBtn" Grid.Column="7" Background="Transparent" Padding="0,6"
                                Tapped="OnSidebarBypassTapped"
                                ToolTipService.ToolTip="Bypass Master EQ"
                                PointerEntered="OnShortcutIconPointerEntered" PointerExited="OnShortcutIconPointerExited">
                            <FontIcon x:Name="BypassIcon" Glyph="&#xE711;" FontSize="16"
                                      HorizontalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorGhostlyBrush}" IsHitTestVisible="False" />
                        </Border>
                    </Grid>

                    <Grid x:Name="PresetSection" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <!-- Fixed label column matches SourceSection so the
                                 Preset / Source dropdowns line up vertically
                                 even though the words render to slightly
                                 different widths. 44px fits "Preset" at
                                 FontSize=12 with a little headroom. -->
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Preset" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Grid Grid.Column="1" Margin="8,0,0,0">
                            <ComboBox x:Name="PresetComboBox"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      SelectionChanged="OnPresetSelectionChanged"
                                      Background="Transparent" BorderBrush="Transparent"
                                      PointerEntered="OnPresetComboPointerEntered"
                                      PointerExited="OnPresetComboPointerExited" />
                            <TextBlock x:Name="PresetDirtyIndicator" Text="*"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       IsHitTestVisible="False" Visibility="Collapsed"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Button x:Name="PresetSaveButton" Grid.Column="2" Content="Save"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Padding="8,2" MinHeight="0" MinWidth="0"
                                Visibility="Collapsed"
                                Click="OnSavePresetClick"
                                ToolTipService.ToolTip="Save preset" />
                    </Grid>

                    <Grid x:Name="SourceSection" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <!-- Same fixed width as PresetSection so the two
                                 dropdowns share a left edge. -->
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Source" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox x:Name="SourceComboBox" Grid.Column="1" Margin="8,0,0,0"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  SelectionChanged="OnSourceSelectionChanged"
                                  Background="Transparent" BorderBrush="Transparent"
                                  PointerEntered="OnSourceComboPointerEntered"
                                  PointerExited="OnSourceComboPointerExited">
                            <!-- Tag = InputSource wire value. Selection maps by
                                 tag, not index, so the S/PDIF group can sit
                                 together regardless of enum order. -->
                            <ComboBoxItem Content="USB" Tag="0" />
                            <ComboBoxItem x:Name="SourceSpdifItem" Content="S/PDIF" Tag="1" />
                            <ComboBoxItem x:Name="SourceSpdif2Item" Content="S/PDIF 2" Tag="4"
                                          Visibility="Collapsed" />
                            <ComboBoxItem x:Name="SourceSpdif3Item" Content="S/PDIF 3" Tag="5"
                                          Visibility="Collapsed" />
                            <ComboBoxItem x:Name="SourceSpdif4Item" Content="S/PDIF 4" Tag="6"
                                          Visibility="Collapsed" />
                            <ComboBoxItem x:Name="SourceI2sItem" Content="I2S" Tag="2" />
                            <ComboBoxItem x:Name="SourceAdatItem" Content="ADAT" Tag="3"
                                          Visibility="Collapsed" />
                        </ComboBox>
                    </Grid>

                    <StackPanel Spacing="4">
                        <Grid>
                            <!-- Mode selector. Mirrors the macOS sidebar "User Volume ▾" /
                                 "Master Volume ▾" Menu: plain secondary-foreground text with
                                 the chevron baked in, click opens a flyout with two items
                                 and a checkmark on the active mode. -->
                            <TextBlock x:Name="SidebarVolumeModeLabel"
                                       Text="Master Volume ▾"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Tapped="OnSidebarVolumeModeLabelTapped">
                                <FlyoutBase.AttachedFlyout>
                                    <MenuFlyout Placement="Bottom">
                                        <MenuFlyoutItem x:Name="UserVolumeModeMenuItem"
                                                        Text="User Volume"
                                                        Click="OnUserVolumeModeMenuClick" />
                                        <MenuFlyoutItem x:Name="MasterVolumeModeMenuItem"
                                                        Text="Master Volume"
                                                        Click="OnMasterVolumeModeMenuClick" />
                                    </MenuFlyout>
                                </FlyoutBase.AttachedFlyout>
                            </TextBlock>
                            <TextBlock x:Name="MasterVolumeValueText" HorizontalAlignment="Right"
                                       FontSize="12" FontFamily="Cascadia Code, Consolas"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Slider x:Name="MasterVolumeSlider" Minimum="0" Maximum="1000"
                                StepFrequency="1" SmallChange="5" LargeChange="50"
                                IsThumbToolTipEnabled="False"
                                ValueChanged="OnMasterVolumeSliderChanged">
                            <Slider.Resources>
                                <!-- Brushes are rewritten from code-behind on mode change so
                                     master mode tints the track/thumb red (matches macOS
                                     MasterModeSection's `.tint(.red)`). -->
                                <SolidColorBrush x:Key="SliderTrackValueFill" Color="{ThemeResource SystemAccentColor}" />
                                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{ThemeResource SystemAccentColor}" />
                                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{ThemeResource SystemAccentColor}" />
                                <SolidColorBrush x:Key="SliderThumbBackground" Color="{ThemeResource SystemAccentColor}" />
                                <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{ThemeResource SystemAccentColor}" />
                                <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{ThemeResource SystemAccentColor}" />
                            </Slider.Resources>
                        </Slider>
                    </StackPanel>

                </StackPanel>

                <Border Grid.Row="2" Padding="12,8" RightTapped="OnConnectionStatusRightTapped">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <controls:CpuMeter x:Name="Cpu0Meter" Core="0" Label="CPU" VerticalAlignment="Center" />
                        <controls:CpuMeter x:Name="Cpu1Meter" Core="1" Visibility="Collapsed" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Center">
                            <Ellipse x:Name="ConnectionIndicator" Width="7" Height="7" VerticalAlignment="Center" />
                            <Border x:Name="DeviceSelectorBtn" Background="Transparent" Padding="6,3"
                                    CornerRadius="4" BorderThickness="1" BorderBrush="Transparent"
                                    Tapped="OnDeviceSelectorTapped"
                                    PointerEntered="OnDeviceSelectorPointerEntered"
                                    PointerExited="OnDeviceSelectorPointerExited">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock x:Name="DeviceSelectorText" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <FontIcon Glyph="&#xE70D;" FontSize="8" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>

            <Grid x:Name="ContentGrid" Grid.Column="1" Padding="20" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="250" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="GraphArea" Grid.Row="0"
                      PointerEntered="OnGraphAreaPointerEntered"
                      PointerExited="OnGraphAreaPointerExited">
                    <Border CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <controls:BodePlotControl x:Name="BodePlot" />
                    </Border>
                    <Button x:Name="GraphPopoutButton"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,8,8,0" Padding="6"
                            Background="Transparent" BorderThickness="0"
                            Opacity="0" IsHitTestVisible="False"
                            ToolTipService.ToolTip="Graph options"
                            Click="OnGraphOptionsClick">
                        <FontIcon Glyph="&#xE713;" FontSize="14"/>
                    </Button>
                </Grid>

                <!-- While the graph is popped out, a small button in its place
                     brings it back (as does closing the pop-out window). -->
                <Button x:Name="GraphReturnButton" Grid.Row="0"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Padding="8,4" Visibility="Collapsed"
                        ToolTipService.ToolTip="Bring the graph back into this window"
                        Click="OnGraphReturnClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE73F;" FontSize="12"/>
                        <TextBlock Text="Graph" FontSize="12"/>
                    </StackPanel>
                </Button>

                <!-- Graph resize gripper -->
                <controls:ResizeGripper x:Name="GraphGripperControl" Grid.Row="1" Height="12" Background="Transparent"
                        PointerPressed="OnGraphGripperPointerPressed"
                        PointerMoved="OnGraphGripperPointerMoved"
                        PointerReleased="OnGraphGripperPointerReleased">
                    <Rectangle Width="32" Height="3" RadiusX="1.5" RadiusY="1.5"
                               Fill="{ThemeResource ControlStrongFillColorDefaultBrush}"
                               Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </controls:ResizeGripper>

                <!-- (The graph legend pills lived here in Grid.Row 2 — their
                     show/hide role moved to the sidebar channel badges.) -->

                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Static per-channel header (output gain/delay/mute card, or
                         the master input header). Stays fixed above the scrolling
                         filter list; populated by ShowChannelEditor. -->
                    <Border x:Name="ChannelHeaderHost" Grid.Row="0" Visibility="Collapsed" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                        <Grid>
                            <!-- Cards in rows: as many as fit, or the count chosen
                                 from a card's layout gear (MainWindow.DashboardLayout.cs). -->
                            <controls:DashboardGrid x:Name="DashboardPanel" Spacing="16">
                                <controls:DashboardGrid.ChildrenTransitions>
                                    <TransitionCollection>
                                        <AddDeleteThemeTransition />
                                        <RepositionThemeTransition />
                                    </TransitionCollection>
                                </controls:DashboardGrid.ChildrenTransitions>
                            </controls:DashboardGrid>
                            <StackPanel x:Name="ChannelEditorPanel" Visibility="Collapsed"
                                        Spacing="12" />
                        </Grid>
                    </ScrollViewer>

                    <!-- Status bar pinned below the filter list (always visible).
                         The 14px top margin matches the gap between filter rows.
                         Populated by AddFilterSection; hidden while the dashboard shows. -->
                    <Border x:Name="FilterStatusBarHost" Grid.Row="2" Margin="0,14,0,0"
                            Visibility="Collapsed" />
                </Grid>
            </Grid>

            <!-- Firmware mismatch: across the whole window, drawn over the top
                 of the panes so the layout never moves when it appears. Shown
                 only when the device's firmware differs from what this Console
                 expects; Close hides it until the app is next started. -->
            <InfoBar x:Name="FirmwareMismatchBar" Grid.ColumnSpan="2"
                     VerticalAlignment="Top" Margin="8,4,8,0"
                     Canvas.ZIndex="10" Severity="Warning" IsOpen="False"
                     Closed="OnFirmwareMismatchBarClosed">
                <InfoBar.ActionButton>
                    <Button x:Name="FirmwareMismatchButton" Click="OnFirmwareMismatchActionClick"/>
                </InfoBar.ActionButton>
            </InfoBar>
        </Grid>

        <!-- The Getting Started wizard takes the console's place here, crossfading
             with it (MainWindow.Onboarding.cs). -->
        <ContentControl x:Name="OnboardingHost" Grid.Row="1" Visibility="Collapsed"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
</Window>